<?xml version="1.0"?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       Properties
  ================================================================ -->
  <xacro:property name="PI" value="3.14159265359"/>

  <!-- chassis -->
  <xacro:property name="base_length" value="0.40"/>
  <xacro:property name="base_width"  value="0.30"/>
  <xacro:property name="base_height" value="0.10"/>
  <xacro:property name="base_mass"   value="1.50"/>

  <!-- drive wheels -->
  <xacro:property name="wheel_radius"     value="0.10"/>
  <xacro:property name="wheel_width"      value="0.05"/>
  <xacro:property name="wheel_mass"       value="0.25"/>
  <!-- distance between the two wheel centres -->
  <xacro:property name="wheel_separation" value="0.35"/>

  <!-- ball caster -->
  <xacro:property name="caster_radius" value="0.025"/>
  <!-- z-offset of caster centre in base_link frame so it touches the ground -->
  <xacro:property name="caster_z" value="${-(wheel_radius - caster_radius)}"/>

  <!-- ================================================================
       Materials
  ================================================================ -->
  <material name="blue">  <color rgba="0.20 0.40 0.80 1.0"/> </material>
  <material name="gray">  <color rgba="0.60 0.60 0.60 1.0"/> </material>
  <material name="black"> <color rgba="0.10 0.10 0.10 1.0"/> </material>

  <!-- ================================================================
       Inertia helpers
  ================================================================ -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(w*w+h*h)/12}" iyy="${m*(l*l+h*h)/12}" izz="${m*(l*l+w*w)/12}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" iyy="${m*(3*r*r+h*h)/12}" izz="${m*r*r/2}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" iyy="${2*m*r*r/5}" izz="${2*m*r*r/5}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ================================================================
       Base footprint  (ground reference frame)
  ================================================================ -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <!-- lift chassis so wheel bottoms sit on z=0 -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ================================================================
       Chassis
  ================================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" l="${base_length}" w="${base_width}" h="${base_height}"/>
  </link>

  <!-- ================================================================
       Drive wheel macro
  ================================================================ -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">

    <link name="${prefix}_wheel_link">
      <visual>
        <!-- rotate cylinder so its axis aligns with Y -->
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_reflect * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.05"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>1.0</kd>
    </gazebo>

  </xacro:macro>

  <xacro:drive_wheel prefix="left"  y_reflect=" 1"/>
  <xacro:drive_wheel prefix="right" y_reflect="-1"/>

  <!-- ================================================================
       Ball caster macro  (zero friction so it slides freely)
  ================================================================ -->
  <xacro:macro name="ball_caster" params="prefix x_pos">

    <link name="${prefix}_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="0.05" r="${caster_radius}"/>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${prefix}_caster_link"/>
      <origin xyz="${x_pos} 0 ${caster_z}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${prefix}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

  </xacro:macro>

  <xacro:ball_caster prefix="front" x_pos=" ${base_length/2 - caster_radius}"/>
  <xacro:ball_caster prefix="back"  x_pos="${-(base_length/2 - caster_radius)}"/>

  <!-- ================================================================
       ros2_control hardware interface tag
       (read by gz_ros2_control plugin at runtime)
  ================================================================ -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max"> 10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max"> 10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ================================================================
       Gazebo: load gz_ros2_control system plugin
       $(find …) is resolved by xacro to the installed share path.
  ================================================================ -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find robot_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
